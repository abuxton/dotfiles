#

export JIRA_API_TOKEN=$(cat ~/Dropbox/profile/atlassian/jira_api_token.txt)



function atlassian_profile() {
  local jira_dir="$HOME/.config/.jira"
  local completion="$jira_dir/.jira_completion"
  local temporary
  mkdir -p "$jira_dir" || return
  if [ -n "$ZSH_VERSION" ]; then
    if [ ! -s "$completion" ] || [ "$(command -v jira)" -nt "$completion" ] || [ -n "$(find "$completion" -mtime +0 -print)" ]; then
      temporary=$(mktemp "$completion.XXXXXX") || return
      if jira completion zsh > "$temporary" && [ -s "$temporary" ]; then
        if ! mv "$temporary" "$completion"; then
          rm -f "$temporary"
          return 1
        fi
      else
        rm -f "$temporary"
        echo "Failed to generate Jira completion" >&2
        return 1
      fi
    fi
    source "$completion"
  fi
  if [ ! -f "$jira_dir/.config.yml" ]; then
    cp "$HOME/Dropbox/profile/atlassian/.jira/.config.yml" "$jira_dir/.config.yml" || return
  fi
}

if 	[ -x "$(command -v jira)" ]; then
	# 	  echo "jira!"
	atlassian_profile

else
	echo "jira cli not found, skipping jira completion"
fi

alias jira-helper="echo '#jira init --installation cloud --server <SERVER_URL> --login <LOGIN> --auth-type basic  --project <PROJECT_KEY> --force --debug' "

function jira-init() {
	# server, login, project key should be set in .jira/.config.yml
	echo "Initializing jira profile configuration"

	export JIRA_SERVER=$(cat ~/Dropbox/profile/atlassian/.jira/.config.yml |  yaml2json | jq .servers.atlassian.url -r)
	export JIRA_LOGIN=$(cat ~/Dropbox/profile/atlassian/.jira/.config.yml |  yaml2json | jq .servers.atlassian.email -r)
	export JIRA_PROJECT_KEY=$(cat  ~/Dropbox/profile/atlassian/.jira/HDM.config.yml | yaml2json | jq .project.key -r)
	export JIRA_INIT="#jira init --installation cloud --server $JIRA_SERVER --login $JIRA_LOGIN --auth-type basic  --project $JIRA_PROJECT_KEY --force --debug"

echo "Jira profile configuration initialized"
echo "run '$JIRA_INIT ' to see the jira init with the current configuration"
}
